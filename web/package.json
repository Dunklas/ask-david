{
  "name": "ask-david",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "check-format": "prettier . --check",
    "format": "prettier . --write",
    "preview": "vite preview",
    "validate": "npm run lint && npm run check-format && npm run test",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 src/assets/david3.webp"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@mlc-ai/web-llm": "^0.2.87",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "autoprefixer": "^10.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "postcss": "^8.5.26",
    "react": "^19.0.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.0"
  }
}
